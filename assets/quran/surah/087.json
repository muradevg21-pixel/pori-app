{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":87,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","bn":"তোমার মহান প্রতিপালকের নামের পবিত্রতা ও মহিমা ঘোষণা কর।","w":[["سَبِّحِ","মহিমা ঘোষণা করো"],["ٱسْمَ","নামের"],["رَبِّكَ","তোমার রবের"],["ٱلْأَعْلَى","সুমহান"]],"juz":30,"page":591,"sajdah":false},{"n":2,"ar":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","bn":"যিনি সৃষ্টি করেছেন অতঃপর করেছেন (দেহের প্রতিটি অঙ্গকে) সামঞ্জস্যপূর্ণ।","w":[["ٱلَّذِى","যিনি"],["خَلَقَ","সৃষ্টি করেছেন"],["فَسَوَّىٰ","অতঃপর সুবিন্যস্ত করেছেন"]],"juz":30,"page":591,"sajdah":false},{"n":3,"ar":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","bn":"যিনি সকল বস্তুকে পরিমাণ মত সৃষ্টি করেছেন, অতঃপর (জীবনে চলার) পথনির্দেশ করেছেন।","w":[["وَٱلَّذِى","এবং যিনি"],["قَدَّرَ","নিয়তি নির্ধারণ করেছেন"],["فَهَدَىٰ","অতঃপর পথ দেখিয়েছেন"]],"juz":30,"page":591,"sajdah":false},{"n":4,"ar":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","bn":"যিনি তৃণ ইত্যাদি বের করেছেন।","w":[["وَٱلَّذِىٓ","এবং যিনি"],["أَخْرَجَ","উৎপন্ন করেছেন"],["ٱلْمَرْعَىٰ","তৃণ"]],"juz":30,"page":591,"sajdah":false},{"n":5,"ar":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","bn":"অতঃপর তাকে কাল আবর্জনায় পরিণত করেছেন।","w":[["فَجَعَلَهُۥ","অতঃপর তা পরিণত করেছেন"],["غُثَآءً","আবর্জনায়"],["أَحْوَىٰ","কালো"]],"juz":30,"page":591,"sajdah":false},{"n":6,"ar":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","bn":"আমি তোমাকে পড়িয়ে দেব, যার ফলে তুমি ভুলে যাবে না।","w":[["سَنُقْرِئُكَ","তোমাকে শীঘ্রই আমরা পড়িয়ে দেব"],["فَلَا","অতঃপর না"],["تَنسَىٰٓ","তুমি ভুলবে"]],"juz":30,"page":591,"sajdah":false},{"n":7,"ar":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","bn":"তবে ওটা বাদে যেটা আল্লাহ (রহিত করার) ইচ্ছে করবেন। তিনি জানেন যা প্রকাশ্য আর যা গোপন।","w":[["إِلَّا","এ ব্যতীত"],["مَا","যা"],["شَآءَ","ইচ্ছা করেন"],["ٱللَّهُ ۚ","আল্লাহ্‌"],["إِنَّهُۥ","নিশ্চয়ই তিনি"],["يَعْلَمُ","জানেন"],["ٱلْجَهْرَ","প্রকাশ্য (বিষয়)"],["وَمَا","ও যা কিছু"],["يَخْفَىٰ","কেউ গোপন করে"]],"juz":30,"page":591,"sajdah":false},{"n":8,"ar":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","bn":"আমি তোমার জন্য সহজপথ (অনুসরণ করা) আরো সহজ করে দেব।","w":[["وَنُيَسِّرُكَ","এবং আমরা তোমাকে সহজ করে দিবো"],["لِلْيُسْرَىٰ","সহজ (পন্থাকে)"]],"juz":30,"page":591,"sajdah":false},{"n":9,"ar":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","bn":"কাজেই তুমি উপদেশ দাও যদি উপদেশ উপকার দেয়।","w":[["فَذَكِّرْ","অতঃপর উপদেশ দাও"],["إِن","যদি"],["نَّفَعَتِ","কল্যাণকর হয়"],["ٱلذِّكْرَىٰ","উপদেশ"]],"juz":30,"page":591,"sajdah":false},{"n":10,"ar":"سَيَذَّكَّرُ مَن يَخْشَىٰ","bn":"যে ভয় করে সে উপদেশ গ্রহণ করবে।","w":[["سَيَذَّكَّرُ","সে শীঘ্রই শিক্ষা নেবে"],["مَن","যে"],["يَخْشَىٰ","ভয় করে"]],"juz":30,"page":591,"sajdah":false},{"n":11,"ar":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","bn":"আর তা উপেক্ষা করবে যে চরম হতভাগা।","w":[["وَيَتَجَنَّبُهَا","আর তা পাশ কাটাবে/ উপেক্ষা করবে"],["ٱلْأَشْقَى","নিতান্তই হতভাগা"]],"juz":30,"page":592,"sajdah":false},{"n":12,"ar":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","bn":"যে ভয়াবহ আগুনে প্রবেশ করবে।","w":[["ٱلَّذِى","যে"],["يَصْلَى","প্রবেশ করবে"],["ٱلنَّارَ","আগুনে"],["ٱلْكُبْرَىٰ","ভয়াবহ"]],"juz":30,"page":592,"sajdah":false},{"n":13,"ar":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","bn":"অতঃপর সেখানে সে না (মরার মত) মরবে, আর না (বাঁচার মত) বাঁচবে।","w":[["ثُمَّ","অতঃপর"],["لَا","না"],["يَمُوتُ","সে মরবে"],["فِيهَا","তার মধ্যে"],["وَلَا","আর না"],["يَحْيَىٰ","বাঁচবে"]],"juz":30,"page":592,"sajdah":false},{"n":14,"ar":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","bn":"সাফল্য লাভ করবে সে যে নিজেকে পরিশুদ্ধ করে,","w":[["قَدْ","নিশ্চয়ই"],["أَفْلَحَ","সে সাফল্য পেলো"],["مَن","যে"],["تَزَكَّىٰ","পবিত্র হলো"]],"juz":30,"page":592,"sajdah":false},{"n":15,"ar":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","bn":"আর তার প্রতিপালকের নাম স্মরণ করে ও নামায কায়েম করে।","w":[["وَذَكَرَ","স্মরণ করল"],["ٱسْمَ","নাম"],["رَبِّهِۦ","তার রবের"],["فَصَلَّىٰ","অতঃপর সে  সালাত পড়ল"]],"juz":30,"page":592,"sajdah":false},{"n":16,"ar":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","bn":"কিন্তু তোমরা তো দুনিয়ার জীবনকেই প্রাধান্য দাও,","w":[["بَلْ","বরং"],["تُؤْثِرُونَ","তোমরা প্রাধান্য দাও"],["ٱلْحَيَوٰةَ","জীবনকে"],["ٱلدُّنْيَا","দুনিয়ার/ পার্থিব"]],"juz":30,"page":592,"sajdah":false},{"n":17,"ar":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","bn":"অথচ আখিরাতই অধিক উৎকৃষ্ট ও স্থায়ী।","w":[["وَٱلْـَٔاخِرَةُ","অথচ পরকাল"],["خَيْرٌۭ","উত্তম"],["وَأَبْقَىٰٓ","ও স্থায়ী"]],"juz":30,"page":592,"sajdah":false},{"n":18,"ar":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","bn":"আগের কিতাবগুলোতে এ কথা (লিপিবদ্ধ) আছে,","w":[["إِنَّ","নিশ্চয়ই"],["هَـٰذَا","এটা (ছিল)"],["لَفِى","অবশ্যই মধ্যে"],["ٱلصُّحُفِ","সহীফাসমূহের"],["ٱلْأُولَىٰ","পূর্ববর্তী"]],"juz":30,"page":592,"sajdah":false},{"n":19,"ar":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","bn":"ইবরাহীম ও মূসার কিতাবে।","w":[["صُحُفِ","সহীফাসমূহে"],["إِبْرَٰهِيمَ","ইব্রাহীমের"],["وَمُوسَىٰ","ও মূসার"]],"juz":30,"page":592,"sajdah":false}]}