{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":83,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَيْلٌ لِّلْمُطَفِّفِينَ","bn":"দুর্ভোগ ঠকবাজদের জন্য (যারা মাপে বা ওজনে কম দেয়),","w":[["وَيْلٌۭ","দুর্ভোগ"],["لِّلْمُطَفِّفِينَ","যারা ওজনে/ মাপে কম দেয়"]],"juz":30,"page":587,"sajdah":false},{"n":2,"ar":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","bn":"যারা লোকের কাছ থেকে মেপে নেয়ার সময় পুরামাত্রায় নেয়,","w":[["ٱلَّذِينَ","যারা"],["إِذَا","যখন"],["ٱكْتَالُوا۟","মেপে নেয়"],["عَلَى","থেকে"],["ٱلنَّاسِ","লোকদের"],["يَسْتَوْفُونَ","তারা পূর্ণমাত্রায় নেয়"]],"juz":30,"page":587,"sajdah":false},{"n":3,"ar":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","bn":"আর যখন তাদেরকে মেপে দেয় বা ওজন ক’রে দেয় তখন কম দেয়।","w":[["وَإِذَا","কিন্তু যখন"],["كَالُوهُمْ","তাদের মেপে দেয়"],["أَو","বা"],["وَّزَنُوهُمْ","তাদের ওজন করে দেয়"],["يُخْسِرُونَ","তারা কম করে দেয়"]],"juz":30,"page":587,"sajdah":false},{"n":4,"ar":"أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","bn":"তারা কি চিন্তা করে না যে (তাদের মৃত্যুর পর) তাদেরকে আবার উঠানো হবে,","w":[["أَلَا","না কি"],["يَظُنُّ","চিন্তা করে"],["أُو۟لَـٰٓئِكَ","ঐসব লোকেরা"],["أَنَّهُم","যে তারা"],["مَّبْعُوثُونَ","আবার ওঠানো হবে"]],"juz":30,"page":587,"sajdah":false},{"n":5,"ar":"لِيَوْمٍ عَظِيمٍ","bn":"এক মহা দিবসে।","w":[["لِيَوْمٍ","দিনের জন্যে"],["عَظِيمٍۢ","এক মহা"]],"juz":30,"page":588,"sajdah":false},{"n":6,"ar":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ","bn":"যেদিন মানুষ বিশ্বজগতের প্রতিপালকের সামনে দাঁড়াবে।","w":[["يَوْمَ","যেদিন"],["يَقُومُ","দাঁড়াবে"],["ٱلنَّاسُ","মানুষ"],["لِرَبِّ","রবের সামনে"],["ٱلْعَـٰلَمِينَ","বিশ্বজগতের"]],"juz":30,"page":588,"sajdah":false},{"n":7,"ar":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ","bn":"(তারা যে সব ধারণা করছে তা) কক্ষনো না, নিশ্চয়ই পাপীদের ‘আমালনামা সিজ্জীনে (সংরক্ষিত) আছে।","w":[["كَلَّآ","কখনও না"],["إِنَّ","নিশ্চয়ই"],["كِتَـٰبَ","আমলনামা"],["ٱل