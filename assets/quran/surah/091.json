{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":91,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا","bn":"শপথ সূর্যের ও তার (উজ্জ্বল) কিরণের,","w":[["وَٱلشَّمْسِ","শপথ সূর্যের"],["وَضُحَىٰهَا","এবং তার কিরণের"]],"juz":30,"page":595,"sajdah":false},{"n":2,"ar":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","bn":"শপথ চাঁদের যখন তা সূর্যের পিছনে আসে,","w":[["وَٱلْقَمَرِ","শপথ চাঁদের"],["إِذَا","যখন"],["تَلَىٰهَا","তার পিছে আসে"]],"juz":30,"page":595,"sajdah":false},{"n":3,"ar":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","bn":"শপথ দিনের যখন তা সূর্যকে উদ্ভাসিত করে,","w":[["وَٱلنَّهَارِ","শপথ দিনের"],["إِذَا","যখন"],["جَلَّىٰهَا","তাকে প্রকাশ করে"]],"juz":30,"page":595,"sajdah":false},{"n":4,"ar":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","bn":"শপথ রাতের যখন তা সূর্যকে ঢেকে নেয়,","w":[["وَٱلَّيْلِ","শপথ রাতের"],["إِذَا","যখন"],["يَغْشَىٰهَا","তাকে ঢেকে ফেলে"]],"juz":30,"page":595,"sajdah":false},{"n":5,"ar":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","bn":"শপথ আসমানের আর সেটা যিনি বানিয়েছেন তাঁর,","w":[["وَٱلسَّمَآءِ","শপথ আকাশের"],["وَمَا","এবং যিনি"],["بَنَىٰهَا","তা তৈরি করেছেন"]],"juz":30,"page":595,"sajdah":false},{"n":6,"ar":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","bn":"শপথ যমীনের আর সেটা যিনি বিছিয়েছেন তাঁর,","w":[["وَٱلْأَرْضِ","শপথ পৃথিবীর"],["وَمَا","এবং যিনি"],["طَحَىٰهَا","তা বিস্তৃত করেছেন"]],"juz":30,"page":595,"sajdah":false},{"n":7,"ar":"وَنَفْسٍ وَمَا سَوَّىٰهَا","bn":"শপথ প্রাণের আর তাঁর যিনি তা সামঞ্জস্যপূর্ণ করেছেন,","w":[["وَنَفْسٍۢ","শপথ মানুষের"],["وَمَا","এবং যিনি"],["سَوَّىٰهَا","তাকে সুঠাম করেছেন"]],"juz":30,"page":595,"sajdah":false},{"n":8,"ar":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","bn":"অতঃপর তাকে তার অসৎকর্ম ও সৎকর্মের জ্ঞান দান করেছেন।","w":[["فَأَلْهَمَهَا","অতঃপর তাকে জ্ঞান দিয়েছেন"],["فُجُورَهَا","তার মন্দকাজ"],["وَتَقْوَىٰهَا","ও তার তাকওয়া (সম্পর্কে )"]],"juz":30,"page":595,"sajdah":false},{"n":9,"ar":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","bn":"সেই সফলকাম হয়েছে যে নিজ আত্মাকে পবিত্র করেছে।","w":[["قَدْ","নিশ্চয়ই"],["أَفْلَحَ","সফল হলো"],["مَن","যে"],["زَكَّىٰهَا","তাকে পবিত্র করলো"]],"juz":30,"page":595,"sajdah":false},{"n":10,"ar":"وَقَدْ خَابَ مَن دَسَّىٰهَا","bn":"সেই ব্যর্থ হয়েছে যে নিজ আত্মাকে কলূষিত করেছে।","w":[["وَقَدْ","এবং নিশ্চয়ই"],["خَابَ","ব্যর্থ হলো"],["مَن","যে"],["دَسَّىٰهَا","তাকে কলুষিত করলো"]],"juz":30,"page":595,"sajdah":false},{"n":11,"ar":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","bn":"সামূদ জাতি সীমালঙ্ঘন ক’রে (তাদের নবীকে মেনে নিতে) অস্বীকার করেছিল।","w":[["كَذَّبَتْ","মিথ্যারোপ করেছিল"],["ثَمُودُ","সামূদ জাতি"],["بِطَغْوَىٰهَآ","তার অবাধ্যতাবশতঃ"]],"juz":30,"page":595,"sajdah":false},{"n":12,"ar":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","bn":"যখন তাদের সবচেয়ে হতভাগা লোকটি মাথা চাড়া দিয়ে উঠল।","w":[["إِذِ","যখন"],["ٱنۢبَعَثَ","(তৎপর হয়ে)উঠলো"],["أَشْقَىٰهَا","তার সবচেয়ে হতভাগা ব্যক্তি"]],"juz":30,"page":595,"sajdah":false},{"n":13,"ar":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","bn":"তখন আল্লাহর রাসূল (সালিহ) তাদেরকে বলল, ‘এটা আল্লাহর উটনি, একে পানি পান করতে বাধা দিও না।","w":[["فَقَالَ","অতঃপর বললো"],["لَهُمْ","তাদেরকে"],["رَسُولُ","রাসূল"],["ٱللَّهِ","আল্লাহর"],["نَاقَةَ","\"(সাবধান)উষ্ট্রীকে"],["ٱللَّهِ","আল্লাহর (স্পর্শ করো না)"],["وَسُقْيَـٰهَا","ও তার পানি পান করায় (বাধা দিও না)\""]],"juz":30,"page":595,"sajdah":false},{"n":14,"ar":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","bn":"কিন্তু তারা রসূলের কথা অগ্রাহ্য করল এবং উটনির পায়ের রগ কেটে দিল। শেষ পর্যন্ত তাদের পাপের কারণে তাদের প্রতিপালক তাদেরকে ধ্বংস করে মাটিতে মিশিয়ে দিলেন।","w":[["فَكَذَّبُوهُ","কিন্তু তারা তাকে  মিথ্যা ভাবলো"],["فَعَقَرُوهَا","অতঃপর তারা তাকে  হত্যা করলো"],["فَدَمْدَمَ","ফলে ধ্বংস করে দিলেন"],["عَلَيْهِمْ","তাদেরকে"],["رَبُّهُم","তাদের রব"],["بِذَنۢبِهِمْ","তাদের পাপের জন্য"],["فَسَوَّىٰهَا","অতঃপর তাদেরকে (মাটি) সমান করে দিলেন"]],"juz":30,"page":595,"sajdah":false},{"n":15,"ar":"وَلَا يَخَافُ عُقْبَـٰهَا","bn":"আর তিনি (তাঁর এ কাজের) কোন খারাপ পরিণতির ভয় মোটেই পোষণ করেন না।","w":[["وَلَا","এবং না"],["يَخَافُ","ভয় করেন তিনি"],["عُقْبَـٰهَا","তাঁর (কাজের) পরিণতির"]],"juz":30,"page":595,"sajdah":false}]}