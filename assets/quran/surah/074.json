{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":74,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ","bn":"ওহে বস্ত্র আবৃত (ব্যক্তি)!","w":[["يَـٰٓأَيُّهَا","হে"],["ٱلْمُدَّثِّرُ","চাদরাবৃত"]],"juz":29,"page":575,"sajdah":false},{"n":2,"ar":"قُمْ فَأَنذِرْ","bn":"ওঠ, সতর্ক কর।","w":[["قُمْ","উঠ"],["فَأَنذِرْ","সতর্ক কর অতঃপর"]],"juz":29,"page":575,"sajdah":false},{"n":3,"ar":"وَرَبَّكَ فَكَبِّرْ","bn":"আর তোমার প্রতিপালকের শ্রেষ্ঠত্ব ঘোষণা কর।","w":[["وَرَبَّكَ","ও তোমার রবের"],["فَكَبِّرْ","অতঃপর শ্রেষ্ঠত্ব ঘোষণা কর"]],"juz":29,"page":575,"sajdah":false},{"n":4,"ar":"وَثِيَابَكَ فَطَهِّرْ","bn":"তোমার পোশাক পরিচ্ছদ পবিত্র রাখ।","w":[["وَثِيَابَكَ","এবং তোমার কাপড়"],["فَطَهِّرْ","অতঃপর পবিত্র কর"]],"juz":29,"page":575,"sajdah":false},{"n":5,"ar":"وَٱلرُّجْزَ فَٱهْجُرْ","bn":"(যাবতীয়) অপবিত্রতা থেকে দূরে থাক।","w":[["وَٱلرُّجْزَ","এবং অপবিত্রতা"],["فَٱهْجُرْ","অতএব দূরে থাক"]],"juz":29,"page":575,"sajdah":false},{"n":6,"ar":"وَلَا تَمْنُن تَسْتَكْثِرُ","bn":"(কারো প্রতি) অনুগ্রহ করো না অধিক পাওয়ার উদ্দেশ্যে।","w":[["وَلَا","এবং না"],["تَمْنُن","অনুগ্রহ করো"],["تَسْتَكْثِرُ","বেশী পাওয়ার আশায়"]],"juz":29,"page":575,"sajdah":false},{"n":7,"ar":"وَلِرَبِّكَ فَٱصْبِرْ","bn":"তোমার প্রতিপালকের (সন্তুষ্টির) জন্য ধৈর্য ধর।","w":[["وَلِرَبِّكَ","এবং তোমার রবের জন্যে"],["فَٱصْبِرْ","অতএব সবর কর"]],"juz":29,"page":575,"sajdah":false},{"n":8,"ar":"فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ","bn":"যেদিন শিঙ্গায় ফুঁ দেয়া হবে,","w":[["فَإِذَا","অতঃপর যখন"],["نُقِرَ","ফুক দেয়া হবে"],["فِى","মধ্যে"],["ٱلنَّاقُورِ","সিঙ্গায়"]],"juz":29,"page":575,"sajdah":false},{"n":9,"ar":"فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ","bn":"সেদিনটি হবে বড়ই কঠিন দিন,","w":[["فَذَٰلِكَ","অতএব সেই"],["يَوْمَئِذٍۢ","(হবে) দিন"],["يَوْمٌ","দিন"],["عَسِيرٌ","কঠিন"]],"juz":29,"page":575,"sajdah":false},{"n":10,"ar":"عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍ","bn":"(যা) কাফিরদের জন্য মোটেই সহজ নয়।","w":[["عَلَى","উপর"],["ٱلْكَـٰفِرِينَ","কাফিরদের"],["غَيْرُ","নয়"],["يَسِيرٍۢ","সহজ"]],"juz":29,"page":575,"sajdah":false},{"n":11,"ar":"ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا","bn":"ছেড়ে দাও আমাকে (তার সঙ্গে বুঝাপড়া করার জন্য) যাকে আমি এককভাবে সৃষ্টি করেছি।","w":[["ذَرْنِى","আমাকে ছাড়"],["وَمَنْ","আর যাকে"],["خَلَقْتُ","আমি সৃষ্টি করেছি"],["وَحِيدًۭا","একেলা"]],"juz":29,"page":575,"sajdah":false},{"n":12,"ar":"وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا","bn":"আর তাকে (ওয়ালীদ বিন মুগীরাহকে) দিয়েছি অঢেল ধন-সম্পদ,","w":[["وَجَعَلْتُ","এবং আমি বানিয়েছি"],["لَهُۥ","তার জন্যে"],["مَالًۭا","সম্পদ"],["مَّمْدُودًۭا","বিপুল"]],"juz":29,"page":575,"sajdah":false},{"n":13,"ar":"وَبَنِينَ شُهُودًا","bn":"আর অনেক ছেলে যারা সব সময় তার কাছেই থাকে।","w":[["وَبَنِينَ","এবং সন্তানাদি"],["شُهُودًۭا","সদা উপস্থিত"]],"juz":29,"page":575,"sajdah":false},{"n":14,"ar":"وَمَهَّدتُّ لَهُۥ تَمْهِيدًا","bn":"এবং তার জীবনকে করেছি সচ্ছল ও সুগম।","w":[["وَمَهَّدتُّ","এবং আমি সুগম করেছি"],["لَهُۥ","তার জন্যে"],["تَمْهِيدًۭا","প্রচুর স্বচ্ছলতা"]],"juz":29,"page":575,"sajdah":false},{"n":15,"ar":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","bn":"এর পরও সে লোভ করে যে, আমি তাকে আরো দেই।","w":[["ثُمَّ","এরপর"],["يَطْمَعُ","লালসা সে করে"],["أَنْ","যে"],["أَزِيدَ","অধিক দিব আমি"]],"juz":29,"page":575,"sajdah":false},{"n":16,"ar":"كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًا","bn":"কক্ষনো না, সে ছিল আমার নিদর্শনের বিরুদ্ধাচারী।","w":[["كَلَّآ ۖ","কক্ষণও না"],["إِنَّهُۥ","সে নিশ্চয়"],["كَانَ","হল"],["لِـَٔايَـٰتِنَا","আমাদের নিদর্শনাদির প্রতি"],["عَنِيدًۭا","শত্রুতা ভাবাপন্ন"]],"juz":29,"page":575,"sajdah":false},{"n":17,"ar":"سَأُرْهِقُهُۥ صَعُودًا","bn":"শীঘ্রই আমি তাকে উঠাব শাস্তির পাহাড়ে (অর্থাৎ তাকে দিব বিপদের উপর বিপদ)।","w":[["سَأُرْهِقُهُۥ","তাকে চড়াব আমি শীঘ্রই"],["صَعُودًا","কঠিন চড়াইয়ে"]],"juz":29,"page":575,"sajdah":false},{"n":18,"ar":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","bn":"সে চিন্তা ভাবনা করল এবং সিদ্ধান্ত নিল,","w":[["إِنَّهُۥ","সে নিশ্চয়ই"],["فَكَّرَ","চিন্তা করল"],["وَقَدَّرَ","এবং সে সিদ্ধান্ত নিল"]],"juz":29,"page":575,"sajdah":false},{"n":19,"ar":"فَقُتِلَ كَيْفَ قَدَّرَ","bn":"ধ্বংস হোক সে, কীভাবে সে (কুরআনের অলৌকিকতা স্বীকার করার পরও কেবল অহমিকার বশবর্তী হয়ে নবুওয়াতকে অস্বীকার করার) সিদ্ধান্ত নিল!","w":[["فَقُتِلَ","সে নস্যাৎ তাই হয়েছে"],["كَيْفَ","কেমন"],["قَدَّرَ","সে সিদ্ধান্ত নিল"]],"juz":29,"page":576,"sajdah":false},{"n":20,"ar":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","bn":"আবারো ধ্বংস হোক সে, সে সিদ্ধান্ত নিল কীভাবে!","w":[["ثُمَّ","আবারও"],["قُتِلَ","মার পড়ল"],["كَيْفَ","কেমন"],["قَدَّرَ","সিদ্ধান্ত নিল"]],"juz":29,"page":576,"sajdah":false},{"n":21,"ar":"ثُمَّ نَظَرَ","bn":"তারপর সে তাকালো।","w":[["ثُمَّ","এরপর"],["نَظَرَ","সে তাকাল"]],"juz":29,"page":576,"sajdah":false},{"n":22,"ar":"ثُمَّ عَبَسَ وَبَسَرَ","bn":"তারপর ভ্রু কুঁচকালো আর মুখ বাঁকালো।","w":[["ثُمَّ","পরে"],["عَبَسَ","কপাল কুচড়াল"],["وَبَسَرَ","ও মুখ বাঁকাল"]],"juz":29,"page":576,"sajdah":false},{"n":23,"ar":"ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ","bn":"তারপর সে পিছনে ফিরল আর অহংকার করল।","w":[["ثُمَّ","এরপর"],["أَدْبَرَ","সে ফিরল"],["وَٱسْتَكْبَرَ","এবং অহংকার করল"]],"juz":29,"page":576,"sajdah":false},{"n":24,"ar":"فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ","bn":"তারপর বলল- ‘এ তো যাদু ছাড়া আর কিছু নয়, এতো পূর্বে থেকেই চলে আসছে।","w":[["فَقَالَ","সে বলল অতঃপর"],["إِنْ","\"নয়"],["هَـٰذَآ","এটা"],["إِلَّا","এছাড়া"],["سِحْرٌۭ","জাদু"],["يُؤْثَرُ","চলে আসা"]],"juz":29,"page":576,"sajdah":false},{"n":25,"ar":"إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ","bn":"এটা তো মানুষের কথা মাত্র।’","w":[["إِنْ","নয়"],["هَـٰذَآ","এটা"],["إِلَّا","এছাড়া"],["قَوْلُ","কথা"],["ٱلْبَشَرِ","মানুুষের\""]],"juz":29,"page":576,"sajdah":false},{"n":26,"ar":"سَأُصْلِيهِ سَقَرَ","bn":"শীঘ্রই আমি তাকে জাহান্নামের আগুনে নিক্ষেপ করব।","w":[["سَأُصْلِيهِ","তাকে প্রবেশ আমি শীঘ্রই করাবো"],["سَقَرَ","দোযখে"]],"juz":29,"page":576,"sajdah":false},{"n":27,"ar":"وَمَآ أَدْرَىٰكَ مَا سَقَرُ","bn":"তুমি কি জান জাহান্নামের আগুন কী?","w":[["وَمَآ","এবং কি"],["أَدْرَىٰكَ","তুমি জান"],["مَا","কি সেই"],["سَقَرُ","দোযখ"]],"juz":29,"page":576,"sajdah":false},{"n":28,"ar":"لَا تُبْقِى وَلَا تَذَرُ","bn":"তা কাউকে জীবিতও রাখবে না, আর মৃত অবস্থায়ও ছেড়ে দেবে না।","w":[["لَا","না"],["تُبْقِى","বাকী রাখে"],["وَلَا","এবং না"],["تَذَرُ","ছেড়ে দেয়"]],"juz":29,"page":576,"sajdah":false},{"n":29,"ar":"لَوَّاحَةٌ لِّلْبَشَرِ","bn":"চামড়া ঝলসে দেবে।","w":[["لَوَّاحَةٌۭ","ঝলসে দেয়"],["لِّلْبَشَرِ","চামড়াকে"]],"juz":29,"page":576,"sajdah":false},{"n":30,"ar":"عَلَيْهَا تِسْعَةَ عَشَرَ","bn":"সেখানে নিয়োজিত আছে ঊনিশ জন ফেরেশতা।","w":[["عَلَيْهَا","তার উপর"],["تِسْعَةَ","উনিশ"],["عَشَرَ","(প্রহরী)"]],"juz":29,"page":576,"sajdah":false},{"n":31,"ar":"وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","bn":"আমিই কেবল ফেরেশতাদেরকে জাহান্নামের তত্ত্বাবধায়ক করেছি। আর তাদের (এই) সংখ্যাকে কাফিরদের জন্য একটা পরীক্ষা বানিয়ে দিয়েছি (কেননা তারা এ কথা বিশ্বাসই করতে পারবে না যে মাত্র ঊনিশ জন ফেরেশতা বিশাল জাহান্নামের যাবতীয় দায়িত্ব পালন করবে) আর যেন কিতাবধারীগণ তা দৃঢ়ভাবে বিশ্বাস করে আর ঈমানদারদের ঈমান আরো বৃদ্ধি পায় এবং কিতাবধারীগণ ও ঈমানদারগণ যেন কোন রকম সন্দেহের মধ্যে না থাকে। যাদের অন্তরে রোগ আছে তারা আর কাফিররা যাতে বলে উঠে, ‘‘ এ ধরণের কথা দিয়ে আল্লাহ কী বোঝাতে চেয়েছেন?’’ এভাবে আল্লাহ যাকে চান গুমরাহ করেন আর যাকে চান সঠিক পথে পরিচালিত করেন। তোমার প্রতিপালকের বাহিনী (কারা এবং এর স্যখ্যা কত সে) সম্পর্কে তিনি ছাড়া কেউ জানে না। (জাহান্নামের) এ (বর্ণনা দেয়া হল) কেবল মানুষের নসীহত লাভের জন্য।","w":[["وَمَا","এবং না"],["جَعَلْنَآ","আমরা বানিয়েছি"],["أَصْحَـٰبَ","কর্মচারীদেরকে"],["ٱلنَّارِ","দোযখের"],["إِلَّا","ছাড়া"],["مَلَـٰٓئِكَةًۭ ۙ","ফেরেশতাদের"],["وَمَا","এবং না"],["جَعَلْن