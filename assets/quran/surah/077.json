{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":77,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَـٰتِ عُرْفًا","bn":"পর পর পাঠানো বাতাসের শপথ যা উপকার সাধন করে,","w":[["وَٱلْمُرْسَلَـٰتِ","শপথ প্রেরিত (বায়ুর)"],["عُرْفًۭا","কল্যাণ সুরূপ"]],"juz":29,"page":580,"sajdah":false},{"n":2,"ar":"فَٱلْعَـٰصِفَـٰتِ عَصْفًا","bn":"অতঃপর তা প্রচন্ড ঝড়ের বেগে বইতে থাকে,","w":[["فَٱلْعَـٰصِفَـٰتِ","অতঃপর ঝটিকার"],["عَصْفًۭا","প্রলংকরী"]],"juz":29,"page":580,"sajdah":false},{"n":3,"ar":"وَٱلنَّـٰشِرَٰتِ نَشْرًا","bn":"শপথ সেই বায়ুর যা (মেঘমালাকে) ছড়িয়ে দেয় দূর দূরান্তে,","w":[["وَٱلنَّـٰشِرَٰتِ","এবং (মেঘপুঞ্জ) বিস্তারকারী (বায়ুর)"],["نَشْرًۭا","বিস্তার করা"]],"juz":29,"page":580,"sajdah":false},{"n":4,"ar":"فَٱلْفَـٰرِقَـٰتِ فَرْقًا","bn":"আর বিচ্ছিন্নকারী বাতাসের শপথ যা (মেঘমালাকে) বিচ্ছিন্ন করে,","w":[["فَٱلْفَـٰرِقَـٰتِ","প্রৃথককারী (বায়ুর) অতংপর"],["فَرْقًۭا","পৃথক করা (মেঘকে)"]],"juz":29,"page":580,"sajdah":false},{"n":5,"ar":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا","bn":"অতঃপর (মানুষের অন্তরে) পৌঁছে দেয় (আল্লাহর) স্মরণ,","w":[["فَٱلْمُلْقِيَـٰتِ","অতংপর জাগ্রতকারীদের (অন্তরে)"],["ذِكْرًا","উপদেশ"]],"juz":29,"page":580,"sajdah":false},{"n":6,"ar":"عُذْرًا أَوْ نُذْرًا","bn":"(বিশ্বাসী লোকদেরকে) ক্ষমা চাওয়ার সুযোগ দেয়ার জন্য আর (কাফিরদেরকে) সতর্ক করার জন্য।","w":[["عُذْرًا","অনুশোচনা করা"],["أَوْ","বা"],["نُذْرًا","সতর্কতা সুরূপ"]],"juz":29,"page":580,"sajdah":false},{"n":7,"ar":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ","bn":"তোমাদেরকে যার ও‘য়াদা দেয়া হয়েছে তা অবশ্যই সংঘটিত হবে।","w":[["إِنَّمَا","(যা) মূলতঃ"],["تُوعَدُونَ","তোমাদের ওয়াদা করা হয়েছে"],["لَوَٰقِعٌۭ","সংঘটিত হবে অবশ্যই"]],"juz":29,"page":580,"sajdah":false},{"n":8,"ar":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","bn":"যখন নক্ষত্ররাজির আলো বিলুপ্ত হবে,","w":[["فَإِذَا","যখন অতঃপর"],["ٱلنُّجُومُ","তারকাসমূহ"],["طُمِسَتْ","স্লান করা হবে"]],"juz":29,"page":580,"sajdah":false},{"n":9,"ar":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","bn":"যখন আক