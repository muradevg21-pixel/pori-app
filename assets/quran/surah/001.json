{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":1,"bsm":0,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","bn":"(আরম্ভ করছি) পরম করুণাময় অসীম দয়াময় আল্লাহর নামে।","w":[["بِسْمِ","নামে"],["ٱللَّهِ","আল্লাহ (র)"],["ٱلرَّحْمَـٰنِ","পরম করুণাময়"],["ٱلرَّحِيمِ","অসীম দয়ালু"]],"juz":1,"page":1,"sajdah":false},{"n":2,"ar":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","bn":"যাবতীয় প্রশংসা জগৎসমূহের প্রতিপালক আল্লাহরই জন্য।","w":[["ٱلْحَمْدُ","সকল প্রশংসা"],["لِلَّهِ","আল্লাহ্‌রই জন্য"],["رَبِّ","(যিনি) রব"],["ٱلْعَـٰلَمِينَ","সারা জগতের"]],"juz":1,"page":1,"sajdah":false},{"n":3,"ar":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","bn":"যিনি পরম করুণাময় অতি দয়ালু।","w":[["ٱلرَّحْمَـٰنِ","অশেষ করুণাময়"],["ٱلرَّحِيمِ","পরম দয়ালু"]],"juz":1,"page":1,"sajdah":false},{"n":4,"ar":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","bn":"যিনি প্রতিফল দিবসের মালিক।","w":[["مَـٰلِكِ","অধিপতি"],["يَوْمِ","দিনের"],["ٱلدِّينِ","বিচারের"]],"juz":1,"page":1,"sajdah":false},{"n":5,"ar":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","bn":"আমরা কেবল তোমারই ‘ইবাদাত করি এবং কেবলমাত্র তোমারই সাহায্য প্রার্থনা করি।","w":[["إِيَّاكَ","আপনারই শুধু"],["نَعْبُدُ","আমরা ইবাদত করি"],["وَإِيَّاكَ","এবং আপনারই (কাছে  শুধু)"],["نَسْتَعِينُ","আমরা সাহায্য চাই।"]],"juz":1,"page":1,"sajdah":false},{"n":6,"ar":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","bn":"আমাদেরকে সরল সঠিক পথ প্রদর্শন কর ও তার প্রতি অটুট থাকার তাওফীক দান কর।","w":[["ٱهْدِنَا","আমাদেরকে দেখান"],["ٱلصِّرَٰطَ","পথ"],["ٱلْمُسْتَقِيمَ","সরল সঠিক"]],"juz":1,"page":1,"sajdah":false},{"n":7,"ar":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","bn":"তাদের পথ, যাদের প্রতি তুমি অনুগ্রহ করেছ। তাদের পথ, যারা গযবপ্রাপ্ত (ইয়াহূদী) ও পথভ্রষ্ট (খ্রিস্টান) নয়।","w":[["صِرَٰطَ","(সেই) পথে"],["ٱلَّذِينَ","যাদেরকে"],["أَنْعَمْتَ","আপনি অনুগ্রহ দান করেছেন"],["عَلَيْهِمْ","তাদের উপর"],["غَيْرِ","নয় (পথ)"],["ٱلْمَغْضُوبِ","অভিশপ্তদের"],["عَلَيْهِمْ","যাদের উপর (গজব পরেছে)"],["وَلَا","এবং না"],["ٱلضَّآلِّينَ","পথভ্রষ্টদের"]],"juz":1,"page":1,"sajdah":false}]}