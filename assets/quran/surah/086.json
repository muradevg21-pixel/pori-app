{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":86,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","bn":"শপথ আসমানের আর যা রাতে আসে তার,","w":[["وَٱلسَّمَآءِ","শপথ আকাশের"],["وَٱلطَّارِقِ","এবং রাত্রে আত্মপ্রকাশকারী (নক্ষত্রের)"]],"juz":30,"page":591,"sajdah":false},{"n":2,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","bn":"তুমি কি জান যা রাতে আসে তা কী?","w":[["وَمَآ","এবং কিসে"],["أَدْرَىٰكَ","তোমাকে জানাবে"],["مَا","কি সেই"],["ٱلطَّارِقُ","রাতে আত্মপ্রকাশকারী"]],"juz":30,"page":591,"sajdah":false},{"n":3,"ar":"ٱلنَّجْمُ ٱلثَّاقِبُ","bn":"উজ্জ্বল নক্ষত্র।","w":[["ٱلنَّجْمُ","নক্ষত্র"],["ٱلثَّاقِبُ","উজ্জ্বল"]],"juz":30,"page":591,"sajdah":false},{"n":4,"ar":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","bn":"প্রত্যেক আত্মার সাথে একজন সংরক্ষক আছে।","w":[["إِن","নেই"],["كُلُّ","কোন"],["نَفْسٍۢ","ব্যক্তি"],["لَّمَّا","এ ছাড়া যে"],["عَلَيْهَا","তার উপর"],["حَافِظٌۭ","তত্ত্বাবধায়ক"]],"juz":30,"page":591,"sajdah":false},{"n":5,"ar":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","bn":"অতঃপর মানুষ চিন্তা করে দেখুক কোন জিনিস থেকে তাকে সৃষ্টি করা হয়েছে।","w":[["فَلْيَنظُرِ","অতএব লক্ষ করা উচিৎ"],["ٱلْإِنسَـٰنُ","মানুষের"],["مِمَّ","কি থেকে"],["خُلِقَ","সৃষ্টি করা হয়েছে (তাকে)"]],"juz":30,"page":591,"sajdah":false},{"n":6,"ar":"خُلِقَ مِن مَّآءٍ دَافِقٍ","bn":"তাকে সৃষ্টি করা হয়েছে সবেগে বের হয়ে আসা পানি থেকে।","w":[["خُلِقَ","সৃষ্টি করা হয়েছে"],["مِن","থেকে"],["مَّآءٍۢ","পানি"],["دَافِقٍۢ","সবেগে স্খলিত"]],"juz":30,"page":591,"sajdah":false},{"n":7,"ar":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","bn":"যা বের হয় শিরদাঁড়া ও পাঁজরের মাঝখান থেকে।","w":[["يَخْرُجُ","যা বের হয়"],["مِنۢ","থেকে"],["بَيْنِ","মাঝ"],["ٱلصُّلْبِ","মেরুদণ্ড"],["وَٱلتَّرَآئِبِ","ও বক্ষপিঞ্জরের"]],"juz":30,"page":591,"sajdah":false},{"n":8,"ar":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","bn":"তিনি মানুষকে আবার (জীবনে) ফিরিয়ে আনতে অবশ্যই সক্ষম।","w":[["إِنَّهُۥ","নিশ্চয়ই তিনি"],["عَلَىٰ","ব্যাপারে"],["رَجْعِهِۦ","তার প্রত্যাবর্তনে"],["لَقَادِرٌۭ","অবশ্যই সক্ষম"]],"juz":30,"page":591,"sajdah":false},{"n":9,"ar":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","bn":"যেদিন (কাজকর্ম আকীদা বিশ্বাস ও নিয়্যাত সম্পর্কিত) গোপন বিষয়াদি যাচাই পরখ করা হবে।","w":[["يَوْمَ","সেদিন"],["تُبْلَى","পরীক্ষা করা হবে"],["ٱلسَّرَآئِرُ","গোপন বিষয়াবলী"]],"juz":30,"page":591,"sajdah":false},{"n":10,"ar":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","bn":"সেদিন মানুষের না থাকবে নিজের কোন সামর্থ্য, আর না থাকবে কোন সাহায্যকারী।","w":[["فَمَا","অতঃপর না"],["لَهُۥ","তার জন্য (থাকবে)"],["مِن","কোন"],["قُوَّةٍۢ","শক্তি"],["وَلَا","আর না"],["نَاصِرٍۢ","কোনো সাহায্যকারী"]],"juz":30,"page":591,"sajdah":false},{"n":11,"ar":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","bn":"ঘুরে ঘুরে আসা বৃষ্টিবাহী আকাশের শপথ,","w":[["وَٱلسَّمَآءِ","শপথ আকাশের"],["ذَاتِ","ধারণকারী"],["ٱلرَّجْعِ","বৃষ্টির"]],"juz":30,"page":591,"sajdah":false},{"n":12,"ar":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","bn":"এবং গাছপালার চারা গজানোর সময় বক্ষ দীর্ণকারী যমীনের শপথ, (বৃষ্টিপাতের মাধ্যমে বৃক্ষলতার উৎপাদন যেমন অকাট্য সত্য, তেমনি কুরআন যা ঘোষণা করে তাও অকাট্য সত্য)","w":[["وَٱلْأَرْضِ","শপথ পৃথিবীর (যা)"],["ذَاتِ","বিশিষ্ট"],["ٱلصَّدْعِ","বিদীর্ণ (বক্ষ)"]],"juz":30,"page":591,"sajdah":false},{"n":13,"ar":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","bn":"কুরআন (সত্য-মিথ্যার পার্থক্যকারী) চূড়ান্ত সিদ্ধান্তকারী বাণী,","w":[["إِنَّهُۥ","নিশ্চয় তা"],["لَقَوْلٌۭ","অবশ্যই বাণী"],["فَصْلٌۭ","মীমাংসাকারী"]],"juz":30,"page":591,"sajdah":false},{"n":14,"ar":"وَمَا هُوَ بِٱلْهَزْلِ","bn":"এবং তা কোন হাসি-ঠাট্টামূলক কথা নয়।","w":[["وَمَا","এবং না"],["هُوَ","তা"],["بِٱلْهَزْلِ","হাসি-ঠাট্টার কথা"]],"juz":30,"page":591,"sajdah":false},{"n":15,"ar":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","bn":"এবং তারা (সত্যের বিরুদ্ধে) ষড়যন্ত্র করছে,","w":[["إِنَّهُمْ","নিশ্চয়ই তারা"],["يَكِيدُونَ","ষড়যন্ত্র করছে"],["كَيْدًۭا","ভীষণ ষড়যন্ত্র"]],"juz":30,"page":591,"sajdah":false},{"n":16,"ar":"وَأَكِيدُ كَيْدًا","bn":"আর আমিও (তাদের অন্যায় ধ্বংসাত্মক ষড়যন্ত্র ভন্ডুল করার) কৌশল করছি।","w":[["وَأَكِيدُ","এবং আমি কৌশল করছি"],["كَيْدًۭا","ভীষণ কৌশল"]],"juz":30,"page":591,"sajdah":false},{"n":17,"ar":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","bn":"কাজেই (এই ষড়যন্ত্রকারী) কাফিরদেরকে অবকাশ দাও, তাদেরকে কিছু সময়ের জন্য অবকাশ দাও।","w":[["فَمَهِّلِ","তাই অবকাশ দাও"],["ٱلْكَـٰفِرِينَ","কাফেরদেরকে"],["أَمْهِلْهُمْ","তাদের অবকাশ দাও"],["رُوَيْدًۢا","কিছুক্ষণের"]],"juz":30,"page":591,"sajdah":false}]}