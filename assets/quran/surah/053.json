{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":53,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلنَّجْمِ إِذَا هَوَىٰ","bn":"শপথ তারকার যখন তা অস্ত যায়,","w":[["وَٱلنَّجْمِ","শপথ তারকার"],["إِذَا","যখন"],["هَوَىٰ","অস্তমিত হয়"]],"juz":27,"page":526,"sajdah":false},{"n":2,"ar":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ","bn":"তোমাদের (মাঝে ছোট থেকে বড় হয়েছে সেই) সঙ্গী গুমরাহও নয় আর ভুলপথে পরিচালিতও নয়,","w":[["مَا","না"],["ضَلَّ","পথভ্রষ্ট হয়েছে"],["صَاحِبُكُمْ","তোমাদের সঙ্গী"],["وَمَا","আর না"],["غَوَىٰ","বিপথগামী হয়েছে"]],"juz":27,"page":526,"sajdah":false},{"n":3,"ar":"وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ","bn":"আর সে মনগড়া কথাও বলে না।","w":[["وَمَا","এবং না"],["يَنطِقُ","সে কথা বলে"],["عَنِ","হতে"],["ٱلْهَوَىٰٓ","প্রবৃত্তির তাড়না"]],"juz":27,"page":526,"sajdah":false},{"n":4,"ar":"إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ","bn":"তাতো ওয়াহী যা তার প্রতি প্রত্যাদেশ করা হয়,","w":[["إِنْ","নয়"],["هُوَ","তা"],["إِلَّا","এছাড়া"],["وَحْىٌۭ","ওহী"],["يُوحَىٰ","অবতীর্ণ করা হয় (যা)"]],"juz":27,"page":526,"sajdah":false},{"n":5,"ar":"عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ","bn":"তাকে শিক্ষা দেয় শক্তিশালী,","w":[["عَلَّمَهُۥ","তাকে শিক্ষা দিয়েছে"],["شَدِيدُ","(জিবরাইল) অত্যন্তপ্রবল"],["ٱلْقُوَىٰ","শক্তিতে"]],"juz":27,"page":526,"sajdah":false},{"n":6,"ar":"ذُو مِرَّةٍ فَٱسْتَوَىٰ","bn":"প্রজ্ঞার অধিকারী (জিবরাঈল) সে নিজ আকৃতিতে স্থির হয়ে ছিল,","w":[["ذُو","আছে"],["مِرَّةٍۢ","কৌশলসম্পন্ন"],["فَٱسْتَوَىٰ","অতঃপর সে স্থির হয়ে (দাঁড়িয়ে) ছিল"]],"juz":27,"page":526,"sajdah":false},{"n":7,"ar":"وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ","bn":"আর সে ছিল ঊর্ধ্ব দিগন্তে,","w":[["وَهُوَ","এমতাবস্থায় সে (ছিল)"],["بِٱلْأُفُقِ","দিগন্তে"],["ٱلْأَعْلَىٰ","ঊর্ধ্ব"]],"juz":27,"page":526,"sajdah":false},{"n":8,"ar":"ثُمَّ دَنَا فَتَدَلَّىٰ","bn":"অতঃপর সে (নবীর) নিকটবর্তী হল, অতঃপর আসলো আরো নিকটে,","w":[["ثُمَّ","এরপর"],["دَنَا","সে কাছে এল"],["فَتَدَلَّىٰ","অতঃপর শূন্যে ভেসে রইল"]],"juz":27,"page":526,"sajdah":false},{"n":9,"ar":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ","bn":"ফলে [নবী (সাঃ) ও জিবরাঈলের মাঝে] দুই ধনুকের ব্যবধান রইল অথবা আরো কম।","w":[["فَكَانَ","ফলে সে হল"],["قَابَ","দূরত্বে"],["قَوْسَيْنِ","দুই ধনুকের"],["أَوْ","বা"],["أَدْنَىٰ","(তারও) কিছু কম"]],"juz":27,"page":526,"sajdah":false},{"n":10,"ar":"فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ","bn":"তখন (আল্লাহ) তাঁর বান্দাহর প্রতি ওয়াহী করলেন যা ওয়াহী করার ছিল।","w":[["فَأَوْحَىٰٓ","অতঃপর সে ওহী পৌঁছাল"],["إِلَىٰ","কাছে"],["عَبْدِهِۦ","তাঁর (অর্থাৎ আল্লাহর) বান্দার/ দাসের"],["مَآ","যা"],["أَوْحَىٰ","ওহী পৌঁছানোর"]],"juz":27,"page":526,"sajdah":false},{"n":11,"ar":"مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ","bn":"(নবীর) অন্তঃকরণ মিথ্যে মনে করেনি যা সে দেখে ছিল।","w":[["مَا","না"],["كَذَبَ","মিথ্যা বলেছে"],["ٱلْفُؤَادُ","(তার) অন্তর"],["مَا","যা"],["رَأَىٰٓ","সে দেখেছে"]],"juz":27,"page":526,"sajdah":false},{"n":12,"ar":"أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ","bn":"সে যা দেখেছে সে বিষয়ে তোমরা কি তার সঙ্গে বিতর্ক করবে?","w":[["أَفَتُمَـٰرُونَهُۥ","তার সাথে তোমরা এখন কি তর্ক করছ"],["عَلَىٰ","(তার) উপর"],["مَا","যা"],["يَرَىٰ","সে দেখেছে"]],"juz":27,"page":526,"sajdah":false},{"n":13,"ar":"وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ","bn":"অবশ্যই সে [অর্থাৎ নবী (সা.)] তাকে [অর্থাৎ জিবরাঈল (আঃ)-কে] আরেকবার দেখেছিল","w":[["وَلَقَدْ","এবং নিশ্চয়ই"],["رَءَاهُ","সে তাকে দেখেছে"],["نَزْلَةً","অবতরণে"],["أُخْرَىٰ","আরও একবার (আসল আকৃতিতে)"]],"juz":27,"page":526,"sajdah":false},{"n":14,"ar":"عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ","bn":"শেষসীমার বরই গাছের কাছে,","w":[["عِندَ","কাছে"],["سِدْرَةِ","কুলগাছের"],["ٱلْمُنتَهَىٰ","(জড়জগতের) শেষপ্রান্তে"]],"juz":27,"page":526,"sajdah":false},{"n":15,"ar":"عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ","bn":"যার কাছে অবস্থিত বসবাসের জান্নাত।","w":[["عِندَهَا","তার কাছেই আছে"],["جَنَّةُ","জান্নাত"],["ٱلْمَأْوَىٰٓ","বসবাসের/ মাওয়া"]],"juz":27,"page":526,"sajdah":false},{"n":16,"ar":"إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ","bn":"যখন গাছটি যা দিয়ে ঢেকে থাকার তা দিয়ে ঢাকা ছিল, (যার বর্ণনা মানুষের বোধগম্য নয়)","w":[["إِذْ","যখন"],["يَغْشَى"