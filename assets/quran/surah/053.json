্তই। তোমার প্রতিপালক খুব ভাল করেই জানেন কে তার পথ থেকে গুমরাহ হয়ে গেছে, আর তিনি ভালই জানেন কে সঠিক পথে আছে।","w":[["ذَٰلِكَ","এটা"],["مَبْلَغُهُم","তাদের সীমা"],["مِّنَ","থেকে"],["ٱلْعِلْمِ ۚ","জ্ঞানের"],["إِنَّ","নিশ্চয়ই"],["رَبَّكَ","তোমার রব"],["هُوَ","তিনিই"],["أَعْلَمُ","খুব জানেন"],["بِمَن","(তার) সম্বন্ধে কে"],["ضَلَّ","বিচ্যুত হয়েছে"],["عَن","হতে"],["سَبِيلِهِۦ","তাঁর পথ"],["وَهُوَ","এবং তিনিই"],["أَعْلَمُ","খুব জানেন"],["بِمَنِ","(তার সম্বন্ধে) কে"],["ٱهْتَدَىٰ","সৎপথ পেয়েছে"]],"juz":27,"page":527,"sajdah":false},{"n":31,"ar":"وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى","bn":"যা আছে আকাশে আর যা আছে যমীনে সব আল্লাহরই- যাতে তিনি যারা মন্দ কাজ করে তাদেরকে তাদের কাজের প্রতিফল দেন আর যারা সৎকর্ম করে তাদেরকে দেন শুভ প্রতিফল।","w":[["وَلِلَّهِ","এবং আল্লাহরই মালিকানায়"],["مَا","যা কিছু"],["فِى","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","আকাশের"],["وَمَا","এবং যা কিছু"],["فِى","মধ্যে আছে"],["ٱلْأَرْضِ","পৃথিবীর"],["لِيَجْزِىَ","প্রতিফল যেন দেন"],["ٱلَّذِينَ","(তাদেরকে) যারা"],["أَسَـٰٓـُٔوا۟","মন্দ করেছে"],["بِمَا","ঐ বিষয়ে যা"],["عَمِلُوا۟","তারা কাজ করেছে"],["وَيَجْزِىَ","এবং প্রতিফল দেন (যেন)"],["ٱلَّذِينَ","(তাদেরকে) যারা"],["أَحْسَنُوا۟","সৎকর্ম করেছে"],["بِٱلْحُسْنَى","উত্তমভাবে (প্রতিফল)"]],"juz":27,"page":527,"sajdah":false},{"n":32,"ar":"ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ","bn":"যারা বিরত থাকে বড় বড় পাপ আর অশ্লীল কার্যকলাপ থেকে ছোট খাট দোষ-ত্রুটি ছাড়া; বস্তুতঃ তোমার প্রতিপালক ক্ষমা করার ব্যাপারে অতি প্রশস্ত। তিনি তোমাদের সম্পর্কে খুব ভালভাবেই জানেন যখন তিনি তোমাদেরকে মাটি থেকে সৃষ্টি করেছেন আর যখন তোমরা তোমাদের মায়েদের পেটে ভ্রুণ অবস্থায় ছিলে। কাজেই নিজেদেরকে খুব পবিত্র মনে করো না। কে তাক্বওয়া অবলম্বন করে তা তিনি