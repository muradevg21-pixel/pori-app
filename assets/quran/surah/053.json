তকগুলো নাম যে নাম তোমরা আর তোমাদের পিতৃ পৃরুষরা রেখেছ, এর পক্ষে আল্লাহ কোন প্রমাণ অবতীর্ণ করেননি। তারা তো শুধু অনুমান আর প্রবৃত্তিরই অনুসরণ করে, যদিও তাদের কাছে তাদের প্রতিপালকের পক্ষ থেকে পথ নির্দেশ এসেছে।","w":[["إِنْ","নয়"],["هِىَ","তা"],["إِلَّآ","এছাড়া"],["أَسْمَآءٌۭ","নামসমূহ"],["سَمَّيْتُمُوهَآ","তোমরা নাম দিয়েছ তা"],["أَنتُمْ","তোমরা"],["وَءَابَآؤُكُم","ও তোমাদের পূর্বপুরুষরা"],["مَّآ","না"],["أَنزَلَ","অবতীর্ণ করেছেন"],["ٱللَّهُ","আল্লাহ"],["بِهَا","সে সম্বন্ধে"],["مِن","কোনো"],["سُلْطَـٰنٍ ۚ","সনদ/ প্রমাণ"],["إِن","না"],["يَتَّبِعُونَ","তারা অনুসরণ করে"],["إِلَّا","এছাড়া"],["ٱلظَّنَّ","অনুমানকে"],["وَمَا","এবং তার (যা)"],["تَهْوَى","কামনা করে"],["ٱلْأَنفُسُ ۖ","(তাদের)প্রবৃত্তিসমূহ"],["وَلَقَدْ","অথচ নিশ্চয়ই"],["جَآءَهُم","তাদের কাছে এসেছে"],["مِّن","পক্ষ হতে"],["رَّبِّهِمُ","তাদের রবের"],["ٱلْهُدَىٰٓ","পথনির্দেশ"]],"juz":27,"page":526,"sajdah":false},{"n":24,"ar":"أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ","bn":"মানুষ কি তাই পায় যা সে চায়? (আল্লাহ যাকে যেভাবে ইচ্ছে সেভাবে দেন ইহকালে আর পরকালে),","w":[["أَمْ","কি"],["لِلْإِنسَـٰنِ","মানুষের জন্য (প্রাপ্য হয়)"],["مَا","যা"],["تَمَنَّىٰ","সে কামনা করে"]],"juz":27,"page":526,"sajdah":false},{"n":25,"ar":"فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ","bn":"কেননা আল্লাহই পরকাল আর ইহকালের মালিক।","w":[["فَلِلَّهِ","আল্লাহর বস্তুত জন্য"],["ٱلْـَٔاخِرَةُ","পরকাল"],["وَٱلْأُولَىٰ","ও ইহকাল"]],"juz":27,"page":526,"sajdah":false},{"n":26,"ar":"۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ","bn":"আকাশে কতই না ফেরেশতা আছে তাদের সুপারিশ কোনই কাজে আসবে না, তবে (কাজে আসবে) যদি তিনি অনুমতি দেন যার জন্য আল্লাহ ইচ্ছে করবেন এবং যার প্রতি তিনি সন্তুষ্ট।","w":[["۞ وَكَم","এবং কতইনা"],["مِّن","থেকে"],["مَّلَكٍۢ","ফেরেশতা আছে"],["فِى","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","আকাশের"],["لَا","না"],["تُغْنِى","কাজে আসবে"],["شَفَـٰعَتُهُمْ","তাদের সুপারিশ"],["شَيْـًٔا","কিছুই"],["إِلَّا","এছাড়া যে"],["مِنۢ","মধ্য হতে"],["بَعْدِ","পরে (যখন)"],["أَن","যে"],["يَأْ