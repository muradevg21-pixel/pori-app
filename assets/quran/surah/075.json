{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":75,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ","bn":"আমি কসম করছি ক্বিয়ামতের দিনের,","w":[["لَآ","না"],["أُقْسِمُ","কসম খাচ্ছি"],["بِيَوْمِ","দিনের"],["ٱلْقِيَـٰمَةِ","কিয়ামাতের"]],"juz":29,"page":577,"sajdah":false},{"n":2,"ar":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","bn":"আমি আরো কসম করছি সেই মনের যে (অন্যায় কাজ ক’রে বসলে) নিজেকে ধিক্কার দেয় (যে তোমাদেরকে অবশ্যই আবার জীবিত করে উঠানো হবে)।","w":[["وَلَآ","এবং না"],["أُقْسِمُ","শপথ করছি আমি"],["بِٱلنَّفْسِ","মনের"],["ٱللَّوَّامَةِ","তিরস্কারকারী"]],"juz":29,"page":577,"sajdah":false},{"n":3,"ar":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","bn":"মানুষ কি মনে করে যে, আমি তার হাড়গুলোকে একত্রিত করতে পারব না।","w":[["أَيَحْسَبُ","মনে করেছে কি"],["ٱلْإِنسَـٰنُ","মানুষ"],["أَلَّن","কখন না"],["نَّجْمَعَ","একত্রিত আমরা করব"],["عِظَامَهُۥ","তার অস্তিগুলকে"]],"juz":29,"page":577,"sajdah":false},{"n":4,"ar":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","bn":"কেন নয়, আমি তার আঙ্গুলের ডগা পর্যন্ত সঠিকভাবে বানিয়ে দিতে সক্ষম","w":[["بَلَىٰ","কােনো না"],["قَـٰدِرِينَ","সক্ষম"],["عَلَىٰٓ","এতে"],["أَن","যে"],["نُّسَوِّىَ","পূর্ণবিন্যস্ত আমরা করবো"],["بَنَانَهُۥ","তার আঙ্গুলির অগ্রভাগ"]],"juz":29,"page":577,"sajdah":false},{"n":5,"ar":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ","bn":"কিন্তু মানুষ তার আগামী দিনগুলোতেও পাপাচার করতে চায়।","w":[["بَلْ","বরং"],["يُرِيدُ","চায়ে"],["ٱلْإِنسَـٰنُ","মানুষ"],["لِيَفْجُرَ","কুকর্ম করার জন্য"],["أَمَامَهُۥ","তার ভবিষ্যতেও"]],"juz":29,"page":577,"sajdah":false},{"n":6,"ar":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ","bn":"সে জিজ্ঞেস করে, ‘ক্বিয়ামত দিবস কবে?’","w":[["يَسْـَٔلُ","সে জিজ্ঞাস করে"],["أَيَّانَ","\"কবে"],["يَوْمُ","দিন"],["ٱلْقِيَـٰمَةِ","কিয়ামাতের\""]],"juz":29,"page":577,"sajdah":false},{"n":7,"ar":"فَإِذَا بَرِقَ ٱلْبَصَرُ","bn":"যখন চোখ ধাঁধিয়ে যাবে,","w":[["