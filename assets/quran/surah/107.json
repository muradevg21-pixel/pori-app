{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":107,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","bn":"তুমি কি তাকে দেখেছ, যে কর্মফল (দিবসকে) অস্বীকার করে?","w":[["أَرَءَيْتَ","তুমি কি দেখেছ"],["ٱلَّذِى","(তাকে) যে"],["يُكَذِّبُ","মিথ্যা অভিহিত করে"],["بِٱلدِّينِ","বিচার দিনকে"]],"juz":30,"page":602,"sajdah":false},{"n":2,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","bn":"সে তো সেই (লোক) যে ইয়াতীমকে ধাক্কা দিয়ে সরিয়ে দেয়,","w":[["فَذَٰلِكَ","সে তো সে-ই"],["ٱلَّذِى","যে"],["يَدُعُّ","ধাক্কা দেয়"],["ٱلْيَتِيمَ","ইয়াতিমকে"]],"juz":30,"page":602,"sajdah":false},{"n":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","bn":"এবং মিসকীনকে অন্ন দিতে উৎসাহ দেয় না","w":[["وَلَا","এবং না"],["يَحُضُّ","উৎসাহিত করে"],["عَلَىٰ","ব্যাপারে"],["طَعَامِ","খাদ্যদানের"],["ٱلْمِسْكِينِ","অভাবগ্রস্তকে"]],"juz":30,"page":602,"sajdah":false},{"n":4,"ar":"فَوَيْلٌ لِّلْمُصَلِّينَ","bn":"অতএব দুর্ভোগ সে সব নামায আদায়কারীর","w":[["فَوَيْلٌۭ","অতএব দুর্ভোগ"],["لِّلْمُصَلِّينَ","(ঐসব) সালাত আদায়কারীদের জন্য"]],"juz":30,"page":602,"sajdah":false},{"n":5,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","bn":"যারা নিজেদের নামাযের ব্যাপারে উদাসীন,","w":[["ٱلَّذِينَ","যাদের (বৈশিষ্ট্য হলো)"],["هُمْ","তারা"],["عَن","সম্বন্ধে"],["صَلَاتِهِمْ","তাদের সালাত"],["سَاهُونَ","উদাসীন"]],"juz":30,"page":602,"sajdah":false},{"n":6,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","bn":"যারা লোক দেখানোর জন্য তা করে,","w":[["ٱلَّذِينَ","যাদের (বৈশিষ্ট্য হলো)"],["هُمْ","তারা"],["يُرَآءُونَ","লোকদেখানোর (কাজ করে)"]],"juz":30,"page":602,"sajdah":false},{"n":7,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","bn":"এবং প্রয়োজনীয় গৃহসামগ্রী দানের ছোট খাট সাহায্য করা থেকেও বিরত থাকে।","w":[["وَيَمْنَعُونَ","এবং দেওয়া হতে বিরত থাকে"],["ٱلْمَاعُونَ","সংসারের প্রয়োজনীয় ছোটখাটো জিনিসের"]],"juz":30,"page":602,"sajdah":false}]}