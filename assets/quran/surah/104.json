{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":104,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","bn":"দুর্ভোগ এমন প্রত্যেক ব্যক্তির জন্য যে (সামনাসামনি) মানুষের নিন্দা করে আর (অসাক্ষাতে) দুর্নাম করে,","w":[["وَيْلٌۭ","দুর্ভোগ"],["لِّكُلِّ","প্রত্যেকের"],["هُمَزَةٍۢ","সামনে নিন্দাকারীর"],["لُّمَزَةٍ","পিছনে দোষ প্রচারকারীর"]],"juz":30,"page":601,"sajdah":false},{"n":2,"ar":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","bn":"যে ধন-সম্পদ জমা করে আর বার বার গণনা করে,","w":[["ٱلَّذِى","যে"],["جَمَعَ","জমা করেছে"],["مَالًۭا","অর্থ"],["وَعَدَّدَهُۥ","এবং তা বারবার গণনা করে রেখেছে"]],"juz":30,"page":601,"sajdah":false},{"n":3,"ar":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","bn":"সে মনে করে যে, তার ধন-সম্পদ চিরকাল তার সাথে থাকবে,","w":[["يَحْسَبُ","সে ধারণা করে"],["أَنَّ","যে"],["مَالَهُۥٓ","তার অর্থ"],["أَخْلَدَهُۥ","তাকে অমর করবে"]],"juz":30,"page":601,"sajdah":false},{"n":4,"ar":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","bn":"কক্ষনো না, তাকে অবশ্যই চূর্ণ-বিচূর্ণকারীর মধ্যে নিক্ষেপ করা হবে,","w":[["كَلَّا ۖ","কখনও না"],["لَيُنۢبَذَنَّ","সে নিক্ষিপ্ত হবে অবশ্যই"],["فِى","মধ্যে"],["ٱلْحُطَمَةِ","বিচূর্ণকারী স্থানের"]],"juz":30,"page":601,"sajdah":false},{"n":5,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","bn":"তুমি কি জান চূর্ণ-বিচূর্ণকারী কী?","w":[["وَمَآ","এবং কি"],["أَدْرَىٰكَ","তোমাকে জানাবে"],["مَا","কি"],["ٱلْحُطَمَةُ","বিচূর্ণকারী স্থান"]],"juz":30,"page":601,"sajdah":false},{"n":6,"ar":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","bn":"তা আল্লাহর প্রজ্জ্বলিত আগুন,","w":[["نَارُ","আগুন"],["ٱللَّهِ","আল্লাহর"],["ٱلْمُوقَدَةُ","প্রজ্জ্বলিত"]],"juz":30,"page":601,"sajdah":false},{"n":7,"ar":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","bn":"যা হৃদয় পর্যন্ত পৌঁছে যাবে।","w":[["ٱلَّتِى","যা"],["تَطَّلِعُ","পৌঁছে যাবে"],["عَلَى","উপর"],["ٱلْأَفْـِٔدَةِ","অন্তরসমূহের"]],"juz":30,"page":601,"sajdah":false},{"n":8,"ar":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","bn":"তা তাদের