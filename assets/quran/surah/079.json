{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":79,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلنَّـٰزِعَـٰتِ غَرْقًا","bn":"শপথ সেই ফেরেশতাদের যারা (পাপীদের আত্মা) নির্মমভাবে টেনে বের করে,","w":[["وَٱلنَّـٰزِعَـٰتِ","শপথ সজোরে (প্রাণ) নির্গতকারী (ফেরেশতাদের)"],["غَرْقًۭا","(যারা নির্গত করে) ডুবে"]],"juz":30,"page":583,"sajdah":false},{"n":2,"ar":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا","bn":"আর যারা (নেককারদের আত্মা) খুবই সহজভাবে বের করে,","w":[["وَٱلنَّـٰشِطَـٰتِ","শপথ (আত্মার) বাঁধন উন্মুক্তকারী (ফেরেশতাদের)"],["نَشْطًۭا","(যারা মৃদুভাবে) উন্মুক্ত (করে)"]],"juz":30,"page":583,"sajdah":false},{"n":3,"ar":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا","bn":"শপথ সেই ফেরেশতাদের যারা দ্রুতগতিতে সাঁতার কাটে,","w":[["وَٱلسَّـٰبِحَـٰتِ","শপথ সাঁতারকারী (ফেরেশতাদের)"],["سَبْحًۭا","(যারা তীব্র গতিতে) সাঁতরায়"]],"juz":30,"page":583,"sajdah":false},{"n":4,"ar":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا","bn":"আর (আল্লাহর নির্দেশ পালনের জন্য) ক্ষিপ্র গতিতে এগিয়ে যায়,","w":[["فَٱلسَّـٰبِقَـٰتِ","অতঃপর (শপথ) অগ্রগামী (ফেরেশতাদের)"],["سَبْقًۭا","দ্রুতবেগে"]],"juz":30,"page":583,"sajdah":false},{"n":5,"ar":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","bn":"অতঃপর সব কাজের ব্যবস্থা করে।","w":[["فَٱلْمُدَبِّرَٰتِ","অতঃপর (শপথ) কার্যনির্বাহী (ফেরেশতাদের)"],["أَمْرًۭا","(যারা পরিচালনা করে) কর্ম"]],"juz":30,"page":583,"sajdah":false},{"n":6,"ar":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","bn":"সেদিন ভূকম্পন প্রকম্পিত করবে,","w":[["يَوْمَ","সেদিন"],["تَرْجُفُ","প্রকম্পিত করবে"],["ٱلرَّاجِفَةُ","প্রথম শিংগাধ্বনি"]],"juz":30,"page":583,"sajdah":false},{"n":7,"ar":"تَتْبَعُهَا ٱلرَّادِفَةُ","bn":"তারপর আসবে আরেকটি ভূকম্পন।","w":[["تَتْبَعُهَا","তার অনুসরণ করবে"],["ٱلرَّادِفَةُ","(আরো একটি) শিংগাধ্বনি"]],"juz":30,"page":583,"sajdah":false},{"n":8,"ar":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","bn":"কত হৃদয় সে দিন ভয়ে ভীত হয়ে পড়বে,","w":[["قُلُوبٌۭ","(কতিপয়) হৃদয়"],["يَوْمَئِذٍۢ","সেদিন"],["وَاجِفَةٌ","ভীত-কম্পিত (হবে)"]],"juz":30,"page":583,"sajdah":false},{"n":9,"ar":"أَبْصَـٰرُهَا خَـٰشِعَةٌ","bn":"তাদের দৃষ্টি নত হবে,","w":[["أَبْصَـٰرُهَا","তার দৃষ্টি সমূহ"],["خَـٰشِعَةٌۭ","ভীতসন্ত্রস্ত (হবে)"]],"juz":30,"page":583,"sajdah":false},{"n":10,"ar":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","bn":"তারা বলে, ‘আমাদেরকে কি আগের অবস্থায় ফিরিয়ে আনা হবে?","w":[["يَقُولُونَ","তারা বলে"],["أَءِنَّا","\"অবশ্যই কি আমরা"],["لَمَرْدُودُونَ","অবশ্যই প্রত্যাবর্তিত হবো"],["فِى","মধ্যে"],["ٱلْحَافِرَةِ","পূর্বাবস্থার"]],"juz":30,"page":583,"sajdah":false},{"n":11,"ar":"أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً","bn":"আমরা যখন পচা-গলা হাড় হয়ে যাব (তখনও)?’","w":[["أَءِذَا","যখন কি"],["كُنَّا","আমরা হবো (পরিণত)"],["عِظَـٰمًۭا","হাড়গুলোয়"],["نَّخِرَةًۭ","গলিত\""]],"juz":30,"page":583,"sajdah":false},{"n":12,"ar":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ","bn":"তারা বলে, ‘অবস্থা যদি তাই হয় তাহলে এই ফিরিয়ে আনাটাতো সর্বনাশের ব্যাপার হবে।’","w":[["قَالُوا۟","তারা বলল"],["تِلْكَ","\"এটা"],["إِذًۭا","তা হলে"],["كَرَّةٌ","প্রত্যাবর্তন"],["خَاسِرَةٌۭ","বড়ই ক্ষতিকর (হবে)\""]],"juz":30,"page":583,"sajdah":false},{"n":13,"ar":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ","bn":"ওটা তো কেবল একটা বিকট আওয়াজ,","w":[["فَإِنَّمَا","প্রকৃতপক্ষে"],["هِىَ","তা"],["زَجْرَةٌۭ","বিকট আওয়াজ"],["وَٰحِدَةٌۭ","একটি মাত্র"]],"juz":30,"page":583,"sajdah":false},{"n":14,"ar":"فَإِذَا هُم بِٱلسَّاهِرَةِ","bn":"সহসাই তারা খোলা ময়দানে আবির্ভূত হবে।","w":[["فَإِذَا","অতঃপর তখনই"],["هُم","তারা"],["بِٱلسَّاهِرَةِ","খোলা ময়দানে (হবে)"]],"juz":30,"page":583,"sajdah":false},{"n":15,"ar":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","bn":"মূসার বৃত্তান্ত তোমার কাছে পৌঁছেছে কি?","w":[["هَلْ","কি"],["أَتَىٰكَ","তোমার কাছে এসেছে"],["حَدِيثُ","বৃত্তান্ত"],["مُوسَىٰٓ","মূসার"]],"juz":30,"page":583,"sajdah":false},{"n":16,"ar":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","bn":"যখন তার প্রতিপালক তাকে পবিত্র তুয়া প্রান্তরে ডাক দিয়ে বলেছিলেন","w":[["إِذْ","যখন"],["نَادَىٰهُ","তাকে ডেকেছিলেন"],["رَبُّهُۥ","তার রব"],["بِٱلْوَادِ","উপত্যকায়"],["ٱلْمُقَدَّسِ","পবিত্র"],["طُوًى","তুয়ার"]],"juz":30,"p