{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":93,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","bn":"সকালের উজ্জ্বল আলোর শপথ,","w":[["وَٱلضُّحَىٰ","শপথ প্রথম প্রহরের"]],"juz":30,"page":596,"sajdah":false},{"n":2,"ar":"وَٱلَّيْلِ إِذَا سَجَىٰ","bn":"রাতের শপথ যখন তা হয় শান্ত-নিঝুম,","w":[["وَٱلَّيْلِ","শপথ রাতের"],["إِذَا","যখন"],["سَجَىٰ","নিঝুম হয়"]],"juz":30,"page":596,"sajdah":false},{"n":3,"ar":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","bn":"তোমার প্রতিপালক তোমাকে কক্ষনো পরিত্যাগ করেননি, আর তিনি অসন্তুষ্টও নন।","w":[["مَا","না"],["وَدَّعَكَ","তোমাকে ত্যাগ করেছেন"],["رَبُّكَ","তোমার রব"],["وَمَا","আর না"],["قَلَىٰ","অসন্তুষ্ট হয়েছেন"]],"juz":30,"page":596,"sajdah":false},{"n":4,"ar":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","bn":"অবশ্যই পরবর্তী সময় পূর্ববর্তী সময়ের চেয়ে তোমার জন্য হবে অধিক উৎকৃষ্ট।","w":[["وَلَلْـَٔاخِرَةُ","এবং পরবর্তী (পরকাল) নিশ্চয়ই"],["خَيْرٌۭ","উত্তম"],["لَّكَ","তোমার জন্য"],["مِنَ","অপেক্ষা (সময়)"],["ٱلْأُولَىٰ","পূর্ববর্তী (ইহকাল)"]],"juz":30,"page":596,"sajdah":false},{"n":5,"ar":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","bn":"শীঘ্রই তোমার প্রতিপালক তোমাকে (এত নি‘মাত) দিবেন যার ফলে তুমি সন্তুষ্ট হয়ে যাবে।","w":[["وَلَسَوْفَ","এবং শীঘ্রই অবশ্য"],["يُعْطِيكَ","তোমাকে দান করবেন"],["رَبُّكَ","তোমার রব"],["فَتَرْضَىٰٓ","ফলে তুমি খুশী হবে"]],"juz":30,"page":596,"sajdah":false},{"n":6,"ar":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","bn":"তিনি কি তোমাকে ইয়াতীম অবস্থায় পান নাই? অতঃপর তিনি আশ্রয় দিয়েছেন।","w":[["أَلَمْ","পান নি কি"],["يَجِدْكَ","তিনি তোমাকে"],["يَتِيمًۭا","ইয়াতীমরূপে"],["فَـَٔاوَىٰ","অতঃপর আশ্রয় দিয়েছেন"]],"juz":30,"page":596,"sajdah":false},{"n":7,"ar":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","bn":"তিনি তোমাকে পেয়েছিলেন পথের দিশা-হীন, অতঃপর দেখালেন সঠিক পথ।","w":[["وَوَجَدَكَ","এবং  তিনি তোমাকে পেয়েছিলেন"],["ضَآلًّۭا","পথ অনবহিত (রূপে)"],["فَهَدَىٰ","অতঃপর তিনি পথের দিশা দেন"]],"juz":30,"page":596,"sajdah":false},{"n":8,"ar":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","bn":"তিনি তোমাকে পেলেন নিঃস্ব, অতঃপর করলেন অভাবমুক্ত।","w":[["وَوَجَدَكَ","এবং তোমাকে পেয়েছিলেন"],["عَآئِلًۭا","অভাবী"],["فَأَغْنَىٰ","অতঃপর অভাবমুক্ত করলেন"]],"juz":30,"page":596,"sajdah":false},{"n":9,"ar":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","bn":"কাজেই তুমি ইয়াতীমের প্রতি কঠোরতা করবে না।","w":[["فَأَمَّا","সুতরাং ক্ষেত্রে"],["ٱلْيَتِيمَ","ইয়াতীমের"],["فَلَا","তাই না"],["تَقْهَرْ","কঠোর হয়ো"]],"juz":30,"page":596,"sajdah":false},{"n":10,"ar":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","bn":"এবং ভিক্ষুককে ধমক দিবে না।","w":[["وَأَمَّا","আর ক্ষেত্রে"],["ٱلسَّآئِلَ","প্রার্থীর"],["فَلَا","তাই না"],["تَنْهَرْ","তিরস্কার করো"]],"juz":30,"page":596,"sajdah":false},{"n":11,"ar":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","bn":"আর তুমি তোমার রব-এর নি‘মাতকে (তোমার কথা, কাজকর্ম ও আচরণের মাধ্যমে) প্রকাশ করতে থাক।","w":[["وَأَمَّا","আর প্রসঙ্গ"],["بِنِعْمَةِ","অনুগ্রহের"],["رَبِّكَ","তোমার রবের"],["فَحَدِّثْ","অতঃপর বর্ণনা করো"]],"juz":30,"page":596,"sajdah":false}]}