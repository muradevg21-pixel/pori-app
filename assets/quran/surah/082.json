{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":82,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","bn":"যখন আসমান ফেটে যাবে,","w":[["إِذَا","যখন"],["ٱلسَّمَآءُ","আকাশ"],["ٱنفَطَرَتْ","ফেটে যাবে"]],"juz":30,"page":587,"sajdah":false},{"n":2,"ar":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","bn":"যখন তারকাগুলো বিক্ষিপ্ত হয়ে (ঝরে) পড়বে,","w":[["وَإِذَا","এবং যখন"],["ٱلْكَوَاكِبُ","তারাগুলো"],["ٱنتَثَرَتْ","বিক্ষিপ্ত হবে"]],"juz":30,"page":587,"sajdah":false},{"n":3,"ar":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","bn":"সমুদ্রকে যখন উত্তাল করে তোলা হবে,","w":[["وَإِذَا","এবং যখন"],["ٱلْبِحَارُ","সাগরগুলো"],["فُجِّرَتْ","উথলে উঠবে"]],"juz":30,"page":587,"sajdah":false},{"n":4,"ar":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","bn":"যখন কবরস্থ মানুষদেরকে উঠানো হবে,","w":[["وَإِذَا","এবং যখন"],["ٱلْقُبُورُ","কবরগুলো"],["بُعْثِرَتْ","উন্মোচিত হবে"]],"juz":30,"page":587,"sajdah":false},{"n":5,"ar":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","bn":"তখন প্রত্যেকে জেনে নিবে সে কী আগে পাঠিয়েছিল, আর কী পেছনে ছেড়ে এসেছিল।","w":[["عَلِمَتْ","জানবে"],["نَفْسٌۭ","প্রত্যেক ব্যক্তি"],["مَّا","যা"],["قَدَّمَتْ","সে আগে পাঠিয়েছে"],["وَأَخَّرَتْ","এবং পিছনে ছেড়েছে"]],"juz":30,"page":587,"sajdah":false},{"n":6,"ar":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","bn":"হে মানুষ! কিসে তোমাকে তোমার মহান প্রতিপালক সম্পর্কে ধোঁকায় ফেলে দিয়েছে?","w":[["يَـٰٓأَيُّهَا","হে"],["ٱلْإِنسَـٰنُ","মানুষ"],["مَا","কিসে"],["غَرَّكَ","তোমাকে ধোঁকা দিয়েছে"],["بِرَبِّكَ","তোমার রবের ব্যাপারে"],["ٱلْكَرِيمِ","মহান"]],"juz":30,"page":587,"sajdah":false},{"n":7,"ar":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","bn":"যিনি তোমাকে সৃষ্টি করেছেন, অতঃপর তোমাকে সুঠাম করেছেন, অতঃপর তোমাকে করেছেন ভারসাম্যপূর্ণ।","w":[["ٱلَّذِى","যিনি"],["خَلَقَكَ","তোমাকে সৃষ্টি করেছেন"],["فَسَوَّىٰكَ","অতঃপর তোমাকে সুঠাম করেছেন"],["فَعَدَلَكَ","অতঃপর তোমাকে  সুসামঞ্জস্য করেছেন"]],"juz":30,"page":587,"sajdah":false},{"n":8,"ar":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","bn":"তিনি তোমাকে তাঁর ইচ্ছেমত আকৃতিতে গঠন করেছেন।","w":[["فِىٓ","মধ্যে"],["أَىِّ","যে"],["صُورَةٍۢ","আকৃতিতে"],["مَّا","(যা) যেমন"],["شَآءَ","তিনি চেয়েছেন"],["رَكَّبَكَ","তোমাকে গঠন করেছেন"]],"juz":30,"page":587,"sajdah":false},{"n":9,"ar":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","bn":"না (তোমাদের এই বিভ্রান্তি মোটেই সঠিক নয়), তোমরা তো (আখেরাতের) শাস্তি ও পুরস্কারকে অস্বীকার করে থাক;","w":[["كَلَّا","কখনও নয়"],["بَلْ","বরং"],["تُكَذِّبُونَ","তোমারা মিথ্যা মনে করছ"],["بِٱلدِّينِ","শেষ বিচারকে"]],"juz":30,"page":587,"sajdah":false},{"n":10,"ar":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ","bn":"অবশ্যই তোমাদের উপর নিযুক্ত আছে তত্ত্বাবধায়কগণ;","w":[["وَإِنَّ","এবং নিশ্চয়ই"],["عَلَيْكُمْ","তোমাদের উপর"],["لَحَـٰفِظِينَ","সংরক্ষক দল অবশ্যই (আছে)"]],"juz":30,"page":587,"sajdah":false},{"n":11,"ar":"كِرَامًا كَـٰتِبِينَ","bn":"সম্মানিত লেখকগণ (যারা লিপিবদ্ধ করছে তোমাদের কার্যকলাপ),","w":[["كِرَامًۭا","সম্মানিত"],["كَـٰتِبِينَ","লেখকবৃন্দ"]],"juz":30,"page":587,"sajdah":false},{"n":12,"ar":"يَعْلَمُونَ مَا تَفْعَلُونَ","bn":"তারা জানে তোমরা যা কর।","w":[["يَعْلَمُونَ","তারা জানে"],["مَا","যা"],["تَفْعَلُونَ","তোমরা কর"]],"juz":30,"page":587,"sajdah":false},{"n":13,"ar":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","bn":"নেককারগণ থাকবে নানান নি‘মাতের মাঝে","w":[["إِنَّ","নিশ্চয়ই"],["ٱلْأَبْرَارَ","সৎ ব্যক্তিরা"],["لَفِى","অবশ্যই মধ্যে(থাকবে)"],["نَعِيمٍۢ","স্বাচ্ছন্দ্যে (সুখে-শান্তিতে)"]],"juz":30,"page":587,"sajdah":false},{"n":14,"ar":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","bn":"আর পাপীরা থাকবে জাহান্নামে,","w":[["وَإِنَّ","এবং নিশ্চয়ই"],["ٱلْفُجَّارَ","পাপাচারীরা"],["لَفِى","অবশ্যই মধ্যে (যাবে)"],["جَحِيمٍۢ","দোজখের"]],"juz":30,"page":587,"sajdah":false},{"n":15,"ar":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","bn":"কর্মফলের দিন তারা তাতে প্রবেশ করবে।","w":[["يَصْلَوْنَهَا","সেখানে তারা প্রবেশ করবে"],["يَوْمَ","দিনে"],["ٱلدِّينِ","বিচার"]],"juz":30,"page":587,"sajdah":false},{"n":16,"ar":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","bn":"তারা সেখান থেকে কক্ষনো উধাও