{"_source":"Arabic: Tanzil Quran Text (Uthmani 1.1), tanzil.net, CC BY 3.0, verbatim. Translation & word meanings: Quran.com API v4.","n":84,"bsm":39,"v":[{"n":1,"ar":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","bn":"যখন আসমান ফেটে যাবে,","w":[["إِذَا","যখন"],["ٱلسَّمَآءُ","আকাশ"],["ٱنشَقَّتْ","ফেটে পড়বে"]],"juz":30,"page":589,"sajdah":false},{"n":2,"ar":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","bn":"এবং স্বীয় রব-এর নির্দেশ পালন করবে, আর তাই তার করণীয়।","w":[["وَأَذِنَتْ","এবং সে নির্দেশ পালন করবে"],["لِرَبِّهَا","তার রবের"],["وَحُقَّتْ","ও এটাই তার করণীয়"]],"juz":30,"page":589,"sajdah":false},{"n":3,"ar":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","bn":"এবং যমীনকে যখন প্রসারিত করা হবে,","w":[["وَإِذَا","এবং যখন"],["ٱلْأَرْضُ","পৃথিবী"],["مُدَّتْ","সম্প্রসারিত করা হবে"]],"juz":30,"page":589,"sajdah":false},{"n":4,"ar":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","bn":"আর তা তার ভেতরে যা আছে তা বাইরে নিক্ষেপ করবে ও খালি হয়ে যাবে।","w":[["وَأَلْقَتْ","এবং নিক্ষেপ করবে"],["مَا","যা"],["فِيهَا","তার মধ্যে আছে"],["وَتَخَلَّتْ","এবং তা শূন্য হয়ে যাবে"]],"juz":30,"page":589,"sajdah":false},{"n":5,"ar":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","bn":"এবং স্বীয় রব-এর নির্দেশ পালন করবে আর তাই তার করণীয়।","w":[["وَأَذِنَتْ","এবং সে নির্দেশ পালন করবে"],["لِرَبِّهَا","তার রবের"],["وَحُقَّتْ","এবং এটাই তার জন্য করণীয়"]],"juz":30,"page":589,"sajdah":false},{"n":6,"ar":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ","bn":"হে মানুষ! তোমাকে তোমার রব পর্যন্ত পৌঁছতে বহু কষ্ট স্বীকার করতে হবে, অতঃপর তুমি তাঁর সাক্ষাৎ লাভ করবে।","w":[["يَـٰٓأَيُّهَا","হে"],["ٱلْإِنسَـٰنُ","মানুষ"],["إِنَّكَ","নিশ্চয়ই তুমি"],["كَادِحٌ","পরিশ্রমকারী"],["إِلَىٰ","দিকে"],["رَبِّكَ","তোমার রবের"],["كَدْحًۭا","কঠোর পরিশ্রম"],["فَمُلَـٰقِيهِ","অতঃপর তাঁর (সাথে) সাক্ষাত করবে"]],"juz":30,"page":589,"sajdah":false},{"n":7,"ar":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ","bn":"অতঃপর যার ‘আমালনামা তার ডান হাতে দেয়া হবে।","w":[["فَأَمَّا","অতঃপর (তার) ব্যাপার"],["مَنْ","যাকে"],["أُوتِىَ","দ